# Server-only environment variables (NEVER expose with NEXT_PUBLIC_)

# 1. Existing primary provider (OpenAI-compatible: Groq, OpenAI, etc.)
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# 2. Cloudflare Workers AI fallback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# 3. OpenRouter fallback (:free model route only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# 4. Google Gemini fallback (OpenAI Compatibility Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Contact Form & Resend REST API Configuration
RESEND_API_KEY=
CONTACT_TO_EMAIL=kagithalokesh8@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Rate limiting operates 100% in-memory with zero external dependencies.
# (Optional: UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN can remain empty)
